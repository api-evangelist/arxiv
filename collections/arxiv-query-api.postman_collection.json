      },
      "item": [
        {
          "id": "b123de8c-38d5-4c6b-a4fe-642cce9c8dae",
          "name": "Query Articles",
          "request": {
            "name": "Query Articles",
            "description": {
              "content": "Execute a search query and/or ID lookup against arXiv. Supports field\nprefixes (ti, au, abs, co, jr, cat, rn, id, all), boolean operators\n(AND, OR, ANDNOT), phrase grouping, and date-range filters on\n`submittedDate` and `lastUpdatedDate`. Responses are Atom 1.0 XML.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search_query",
                  "value": "<string>",
                  "description": "Search expression using field prefixes and boolean operators.\nExample: `cat:cs.AI AND ti:transformer`.\n"
                },
                {
                  "disabled": false,
                  "key": "id_list",
                  "value": "<string>",
                  "description": "Comma-separated list of arXiv identifiers to retrieve. May be\ncombined with `search_query` to filter the named IDs by the query.\n"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "0",
                  "description": "Zero-based index of the first returned result."
                },
                {
                  "disabled": false,
                  "key": "max_results",
                  "value": "10",
                  "description": "Maximum number of results returned per request (max 2000)."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "relevance",
                  "description": "Field by which results are sorted."
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "descending",
                  "description": "Order in which sorted results are returned."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/atom+xml"
              }
            ],
            "method": "GET",
            "auth": null
