          "id": "776e6226-a2e4-4679-9f36-d71346f49f17",
          "name": "Invoke An Oai-pmh Verb",
          "request": {
            "name": "Invoke An Oai-pmh Verb",
            "description": {
              "content": "Single OAI-PMH endpoint dispatched by the `verb` parameter. Supports\n`Identify`, `ListSets`, `ListMetadataFormats`, `ListRecords`,\n`ListIdentifiers`, and `GetRecord`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oai"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "verb",
                  "value": "<string>",
                  "description": "(Required) OAI-PMH verb to invoke."
                },
                {
                  "disabled": false,
                  "key": "identifier",
                  "value": "<string>",
                  "description": "OAI identifier (required for `GetRecord`)."
                },
                {
                  "disabled": false,
                  "key": "metadataPrefix",
                  "value": "<string>",
                  "description": "Metadata format prefix (required for `ListRecords`, `ListIdentifiers`, `GetRecord`)."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Lower bound (UTCdatetime) for selective harvesting."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<date>",
                  "description": "Upper bound (UTCdatetime) for selective harvesting."
                },
                {
                  "disabled": false,
                  "key": "set",
                  "value": "<string>",
                  "description": "Set spec (e.g. `cs`, `cs:cs:AI`)."
                },
                {
                  "disabled": false,
                  "key": "resumptionToken",
                  "value": "<string>",
                  "description": "Token returned by a previous list response to fetch the next batch."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
